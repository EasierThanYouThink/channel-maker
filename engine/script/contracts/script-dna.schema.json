{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/script/script-dna.schema.json",
  "title": "Script DNA v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "channel_id", "hook_philosophy", "narrator_personality",
    "sentence_length", "words_per_second", "technical_depth", "humor_level", "information_density",
    "question_usage", "number_usage", "story_structure", "ending_behavior", "cta_philosophy",
    "preferred_cliches", "forbidden_cliches", "fact_verification_requirements", "unresolved_variables",
    "status", "decision_refs", "created_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "script_dna"},
    "channel_id": {"$ref": "common.schema.json#/$defs/channelId"},
    "hook_philosophy": {"type": "string", "minLength": 1},
    "narrator_personality": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sentence_length": {
      "type": "object", "additionalProperties": false, "required": ["qualitative", "target_words"],
      "properties": {
        "qualitative": {"type": "string", "minLength": 1},
        "target_words": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "words_per_second": {
      "type": "object", "additionalProperties": false, "required": ["target", "range"],
      "properties": {
        "target": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "range": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
          ]
        }
      }
    },
    "technical_depth": {"type": "string", "minLength": 1},
    "humor_level": {"type": "string", "minLength": 1},
    "information_density": {"type": "string", "minLength": 1},
    "question_usage": {"type": "string", "minLength": 1},
    "number_usage": {"type": "string", "minLength": 1},
    "story_structure": {"type": "string", "minLength": 1},
    "ending_behavior": {"type": "string", "minLength": 1},
    "cta_philosophy": {"type": "string", "minLength": 1},
    "preferred_cliches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_cliches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fact_verification_requirements": {"type": "string", "minLength": 1},
    "unresolved_variables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["ACTIVE_DISCOVERY", "FROZEN"]},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/relativePath"}},
    "created_by": {"$ref": "common.schema.json#/$defs/creationProvenance"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "FROZEN"}}}, "then": {"properties": {"decision_refs": {"minItems": 1}}}}
  ]
}
