{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/script/common.schema.json",
  "title": "Script DNA Common Definitions v1",
  "$defs": {
    "channelId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "exampleClassification": {"enum": ["experimental", "approved", "rejected", "borderline"]},
    "creationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creator", "tool", "version"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "creator": {"enum": ["HUMAN", "TOOL", "MODEL_ASSISTED"]},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
