{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/script/script-example.schema.json",
  "title": "Script DNA Candidate Example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "example_id", "channel_id", "text", "classification",
    "review_authority", "reasons", "tags", "provenance", "review_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "script_example"},
    "example_id": {"type": "string", "pattern": "^script-example:[a-z0-9][a-z0-9._-]*$"},
    "channel_id": {"$ref": "common.schema.json#/$defs/channelId"},
    "text": {"type": "string", "minLength": 1},
    "classification": {"$ref": "common.schema.json#/$defs/exampleClassification"},
    "review_authority": {"enum": ["unreviewed", "human"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "created_by", "source_ref"],
      "properties": {
        "kind": {"enum": ["human_authored", "model_drafted", "adapted_from_evidence"]},
        "created_by": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "prompt_ref": {"type": "string", "minLength": 1}
      }
    },
    "review_ids": {"type": "array", "items": {"type": "string", "pattern": "^script-example-review:[a-f0-9]{16}$"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"enum": ["approved", "rejected", "borderline"]}}},
      "then": {"properties": {"review_authority": {"const": "human"}, "review_ids": {"minItems": 1}, "reasons": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"classification": {"const": "experimental"}}},
      "then": {"properties": {"review_authority": {"const": "unreviewed"}}}
    }
  ]
}
