{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/script/script-example-review.schema.json",
  "title": "Script Example Human Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "review_id", "example_id", "target_sha256", "decision", "reviewer", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "script_example_review"},
    "review_id": {"type": "string", "pattern": "^script-example-review:[a-f0-9]{16}$"},
    "example_id": {"type": "string", "pattern": "^script-example:[a-z0-9][a-z0-9._-]*$"},
    "target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["approved", "rejected", "borderline"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
