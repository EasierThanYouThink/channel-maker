{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/niche-intelligence/common.schema.json",
  "title": "Niche Intelligence Common Definitions v1",
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^niche:[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
    "channelId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "sourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["HUMAN", "TOOL", "MODEL_ASSISTED"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "publicSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "source_id", "url", "collected_at", "collector", "evidence_class", "reference_role", "representation"],
      "properties": {
        "platform": {"const": "YOUTUBE"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "collected_at": {"type": "string", "format": "date-time"},
        "collector": {"$ref": "#/$defs/collector"},
        "evidence_class": {"const": "PUBLIC_MARKET_EVIDENCE"},
        "reference_role": {"const": "MARKET_EVIDENCE"},
        "representation": {"const": "RAW_PUBLIC_FACT"}
      }
    },
    "creationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creator", "tool", "version"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "creator": {"enum": ["HUMAN", "TOOL", "MODEL_ASSISTED"]},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "sampleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "rationale", "policy_version"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
