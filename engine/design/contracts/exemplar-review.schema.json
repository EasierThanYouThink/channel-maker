{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/design/exemplar-review.schema.json",
  "title": "Channel Design Exemplar Human Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "review_id", "exemplar_id", "target_sha256", "decision", "reviewer", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "design_exemplar_review"},
    "review_id": {"type": "string", "pattern": "^exemplar-review:[a-f0-9]{16}$"},
    "exemplar_id": {"$ref": "common.schema.json#/$defs/exemplarId"},
    "target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["approved", "rejected", "borderline"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
