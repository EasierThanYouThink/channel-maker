{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/library/asset-component.schema.json",
  "title": "Code-First Asset Component v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "component_id", "scope", "channel_id", "category", "name",
    "description", "renderer", "source", "interface", "justification", "produced_for_pilot_ref",
    "status", "review_ids", "created_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "asset_component"},
    "component_id": {"type": "string", "pattern": "^component:(engine|[a-z][a-z0-9-]*):[a-z0-9][a-z0-9._-]*$"},
    "scope": {"enum": ["ENGINE", "CHANNEL"]},
    "channel_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/channelId"}]},
    "category": {"enum": ["primitive", "object", "character", "diagram", "mechanism", "effect"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "renderer": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "exports"],
      "properties": {
        "kind": {"enum": ["tsx", "svg", "raster"]},
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "exports": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "interface": {"type": "object"},
    "justification": {"type": "string", "minLength": 1},
    "produced_for_pilot_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
    "status": {"enum": ["experimental", "approved", "rejected", "deprecated"]},
    "review_ids": {"type": "array", "items": {"type": "string", "pattern": "^component-review:[a-f0-9]{16}$"}, "uniqueItems": true},
    "created_by": {"$ref": "common.schema.json#/$defs/creationProvenance"}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "ENGINE"}}}, "then": {"properties": {"channel_id": {"type": "null"}}}},
    {"if": {"properties": {"scope": {"const": "CHANNEL"}}}, "then": {"required": ["channel_id"], "properties": {"channel_id": {"$ref": "common.schema.json#/$defs/channelId"}}}},
    {"if": {"properties": {"status": {"enum": ["approved", "rejected", "deprecated"]}}}, "then": {"properties": {"review_ids": {"minItems": 1}}}}
  ]
}
