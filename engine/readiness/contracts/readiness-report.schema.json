{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/readiness/readiness-report.schema.json",
  "title": "Channel Readiness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "channel_id", "items", "overall_passed", "authority", "created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "readiness_report"},
    "channel_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "label", "passed", "evidence_refs", "explanation"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "overall_passed": {"type": "boolean"},
    "authority": {"const": "advisory_only"},
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creator", "tool", "version"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "creator": {"enum": ["HUMAN", "TOOL", "MODEL_ASSISTED"]},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
