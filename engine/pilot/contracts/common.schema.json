{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/pilot/common.schema.json",
  "title": "Pilot Lifecycle Common Definitions v1",
  "$defs": {
    "channelId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "creationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creator", "tool", "version"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "creator": {"enum": ["HUMAN", "TOOL", "MODEL_ASSISTED"]},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
