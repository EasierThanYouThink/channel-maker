{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-maker.local/engine/pilot/pilot.schema.json",
  "title": "Pilot Lifecycle Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "channel_id", "pilot_id", "plan", "production", "review", "freeze", "created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "pilot"},
    "artifact_id": {"type": "string", "pattern": "^pilot:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$"},
    "channel_id": {"$ref": "common.schema.json#/$defs/channelId"},
    "pilot_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "format", "target_duration_seconds", "integration_goals"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "format": {"const": "SHORTS"},
        "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "integration_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_ref", "voiceover_ref", "scene_candidate_manifest_refs", "evaluation_result_refs", "render_ref", "production_log_ref"],
      "properties": {
        "script_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
        "voiceover_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
        "scene_candidate_manifest_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceRef"}},
        "evaluation_result_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceRef"}},
        "render_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
        "production_log_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
        "revision": {"type": ["string", "null"], "pattern": "^rev-[a-f0-9]{12}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decided_by", "decided_at", "rationale", "decision_ref", "revise_target", "critic_summary_refs"],
      "properties": {
        "decision": {"oneOf": [{"type": "null"}, {"enum": ["GO", "REVISE", "ABANDON_DIRECTION"]}]},
        "decided_by": {"type": ["string", "null"], "minLength": 1},
        "decided_at": {"type": ["string", "null"], "format": "date-time"},
        "rationale": {"type": ["string", "null"], "minLength": 1},
        "decision_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]},
        "revise_target": {"type": ["string", "null"], "minLength": 1},
        "critic_summary_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceRef"}},
        "rev_id": {"type": ["string", "null"], "pattern": "^rev-[a-f0-9]{12}$"},
        "production_snapshot": {"type": ["object", "null"]},
        "history": {"type": "array", "items": {"type": "object"}}
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "previous_channel_version", "new_channel_version", "frozen_at", "frozen_by", "decision_ref"],
      "properties": {
        "frozen": {"type": "boolean"},
        "previous_channel_version": {"type": ["string", "null"]},
        "new_channel_version": {"type": ["string", "null"]},
        "frozen_at": {"type": ["string", "null"], "format": "date-time"},
        "frozen_by": {"type": ["string", "null"], "minLength": 1},
        "decision_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/relativePath"}]}
      }
    },
    "created_by": {"$ref": "common.schema.json#/$defs/creationProvenance"}
  }
}
