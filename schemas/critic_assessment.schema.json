{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://radicat.local/schemas/critic_assessment.schema.json", "title": "Critic Assessment of a Scene Candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "lifecycle_state", "candidate_artifact_id", "contract_artifact_id", "assessor", "requirement_findings", "gate_findings", "created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "critic_assessment"},
    "artifact_id": {"type": "string", "pattern": "^critic-assessment:[a-z0-9._-]{1,64}$"}, "lifecycle_state": {"const": "complete"},
    "candidate_artifact_id": {"type": "string", "minLength": 1}, "contract_artifact_id": {"type": "string", "minLength": 1},
    "assessor": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["ai_critic", "human_reviewer", "deterministic_validator"]}}},
    "requirement_findings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "outcome", "rationale", "evidence"], "properties": {"requirement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "outcome": {"enum": ["pass", "partial", "fail", "not_assessable"]}, "rationale": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidate_evidence_id"], "properties": {"candidate_evidence_id": {"type": "string", "minLength": 1}, "note": {"type": "string"}}}}}}},
    "gate_findings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "outcome", "rationale", "evidence"], "properties": {"gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "outcome": {"enum": ["pass", "fail", "not_assessable"]}, "rationale": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidate_evidence_id"], "properties": {"candidate_evidence_id": {"type": "string", "minLength": 1}, "note": {"type": "string"}}}}}}},
    "created_by": {"type": "object", "additionalProperties": false, "required": ["tool", "version"], "properties": {"tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}
  }
}
